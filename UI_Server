    } else if (input$data2 == "USER") {
      if (is.null(inFile))
        return(NULL)
      DF3 <-
        data.frame(
          WildBees = row.names(read.csv(inFile$datapath, row.names = 1)),
          Count = read.csv(inFile$datapath, row.names = 1)[, which(colnames(read.csv(inFile$datapath, row.names =
