# Define server logic required to draw a histogram
server <- function(input, output, session) {
  DEBUG = TRUE
  
  #### Optimal Plant Selection Tab ####
  
  output$rep <- renderText({
    input$start
    
    isolate({
      inFile1 <<- input$file1
      n.gens  <<- input$n.gen
      
      if (DEBUG) {
        cat("Start render output \n")
      }
      if (!is.null(input$param)) {
        # if vector not null
        # Compute param k and f of find.mix function
        k = input$k
        f = ""
        
        if (input$k > 20) {
          return("Error: too many plants selected, max = 20")
        } else{
          # Compute index
          abundanceIdx = match('abundance', input$param)
          richnessIdx = match('richness', input$param)
          
          # Concat string in right order to call find.mix function
          if (!is.na(abundanceIdx)) {
            if (input$data == "ULB") {
              f = paste0(input$param[abundanceIdx], ".ulb")
            } else if (input$data == "NATAG") {
              f = paste0(input$param[abundanceIdx], ".natag")
            } else if (input$data == "COMBI") {
              f = paste0(input$param[abundanceIdx], ".combi")
            } else if (input$data == "USER") {
              if (is.null(inFile1))
                return(NULL)
              f = paste0(input$param[abundanceIdx], ".user")
            }
          }
          if (!is.na(richnessIdx)) {
            if (f != "") {
              f = paste0(f, ".")
            }
            if (input$data == "ULB") {
              f = paste0(f, input$param[richnessIdx], ".ulb")
            } else if (input$data == "NATAG") {
              f = paste0(f, input$param[richnessIdx], ".natag")
            } else if (input$data == "COMBI") {
              f = paste0(f, input$param[richnessIdx], ".combi")
            } else if (input$data == "USER") {
              if (is.null(inFile1))
                return(NULL)
              f = paste0(f, input$param[richnessIdx], ".user")
            }
          }
          
          if (DEBUG) {
            cat(paste(f, "\n"))
          }
          
          if (DEBUG) {
            cat(paste(input$start, "\n"))
          }
          
          if (DEBUG) {
            cat("Searching...\n")
          }
          
          
          # Call mix
          if (input$data == "ULB") {
            mix.rep <-
              find.mix.ulb(f, k)
            
            # Display rep
            mix.rep.N = ""
            for (i in 1:input$k) {
              mix.rep.N <- paste(mix.rep.N, mix.rep[i], "\n")
            }
            gsub("_", " ", mix.rep.N)
          } else if (input$data == "NATAG") {
            mix.rep <-
              find.mix.natag(f, k)
            
            # Display rep
            mix.rep.N = ""
            for (i in 1:input$k) {
              mix.rep.N <- paste(mix.rep.N, mix.rep[i], "\n")
            }
            
            gsub("_", " ", mix.rep.N)
          } else if (input$data == "COMBI") {
            mix.rep <-
              find.mix.combi(f, k)
            
            # Display rep
            mix.rep.N = ""
            for (i in 1:input$k) {
              mix.rep.N <- paste(mix.rep.N, mix.rep[i], "\n")
            }
            
            gsub("_", " ", mix.rep.N)
          } else if (input$data == "USER") {
            if (is.null(inFile1))
              return(NULL)
            USERdf <<-  read.csv(inFile1$datapath, row.names = 1)
            if (input$k > (0.7 * ncol(USERdf))) {
              #avoid model errors
              return(
                "Error: too many plant species selected, limited to 70% of database when fewer than 20 species"
              )
            } else{
              mix.rep <-
                find.mix.user(f, k)
              
              # Display rep
              mix.rep.N = ""
              for (i in 1:input$k) {
                mix.rep.N <- paste(mix.rep.N, mix.rep[i], "\n")
              }
              
              gsub("_", " ", mix.rep.N)
            }
          }
        }
      }
    })
  })
  
  
  #### Visualization per Species Tab ####
  
  toListen <- reactive({
    list(input$data2)
  })
  
  observeEvent(toListen(), {
    inFile <- input$file2
    if (input$data2 == "ULB") {
      updateSelectInput(session,
                        input = "bee_vis",
                        choices =  rownames(ULB))
      updateSelectInput(session,
                        input = "plant_vis",
                        choices =  colnames(ULB))
    } else if (input$data2 == "NATAG") {
      updateSelectInput(session,
                        input = "bee_vis",
                        choices = rownames(NATAG))
      updateSelectInput(session,
                        input = "plant_vis",
                        choices =  colnames(NATAG))
    } else if (input$data2 == "COMBI") {
      updateSelectInput(session,
                        input = "bee_vis",
                        choices = rownames(COMBI))
      updateSelectInput(session,
                        input = "plant_vis",
                        choices =  colnames(COMBI))
    } else if (input$data2 == "USER") {
      if (is.null(inFile))
        return(NULL)
      updateSelectInput(session,
                        input = "bee_vis",
                        choices = rownames(read.csv(inFile$datapath, row.names = 1)))
      updateSelectInput(session,
                        input = "plant_vis",
                        choices =  colnames(read.csv(inFile$datapath, row.names = 1)))
    }
  })
  
  output$PLPF <- renderText({
    inFile <- input$file2
    if (input$data2 == "ULB") {
      numRow <- which(rownames(ULB) %in% input$bee_vis)
      gsub("\\..*", "", colnames(ULB[, apply(ULB, 1, which.max)])[numRow])
    } else if (input$data2 == "NATAG") {
      numRow <- which(rownames(NATAG) %in% input$bee_vis)
      gsub("\\..*", "", colnames(NATAG[, apply(NATAG, 1, which.max)])[numRow])
    } else if (input$data2 == "COMBI") {
      numRow <- which(rownames(COMBI) %in% input$bee_vis)
      gsub("\\..*", "", colnames(COMBI[, apply(COMBI, 1, which.max)])[numRow])
    } else{
      if (is.null(inFile))
        return(NULL)
      numRow <-
        which(rownames(read.csv(inFile$datapath, row.names = 1)) %in% input$bee_vis)
      gsub("\\..*", "", colnames(read.csv(inFile$datapath, row.names = 1)[, apply(read.csv(inFile$datapath, row.names =
                                                                                             1), 1, which.max)])[numRow])
    }
  })
  
  output$ALPP <- renderText({
    inFile <- input$file2
    
    if (input$data2 == "ULB") {
      numCol <- which(colnames(ULB) %in% input$plant_vis)
      gsub("\\..*", "", rownames(ULB[apply(ULB, 2, which.max), ])[numCol])
    } else if (input$data2 == "NATAG") {
      numCol <- which(colnames(NATAG) %in% input$plant_vis)
      gsub("\\..*", "", rownames(NATAG[apply(NATAG, 2, which.max), ])[numCol])
    } else if (input$data2 == "COMBI") {
      numCol <- which(colnames(COMBI) %in% input$plant_vis)
      gsub("\\..*", "", rownames(COMBI[apply(COMBI, 2, which.max), ])[numCol])
    } else if (input$data2 == "USER") {
      if (is.null(inFile))
        return(NULL)
      numCol <-
        which(colnames(read.csv(inFile$datapath, row.names = 1)) %in% input$plant_vis)
      gsub("\\..*", "", rownames(read.csv(inFile$datapath, row.names = 1)[apply(read.csv(inFile$datapath, row.names =
                                                                                           1), 2, which.max), ])[numCol])
    }
  })
  
  output$BARPLPF <- renderPlot({
    inFile <- input$file2
    
    if (input$data2 == "ULB") {
      DF1 <- data.frame(Plant = colnames(ULB),
                        Count = as.vector(t(ULB[which(rownames(ULB) %in% input$bee_vis),])))
      if (sum(DF1$Count) == 0) {
        plot.new()
      } else{
        DF <- DF1 %>% filter(Count > 0)
        ggplot(DF, aes(x = Plant, y = Count)) + geom_bar(stat = "identity") +
          theme_minimal() +
          xlab("Visited flowering plants") + ylab("Number of recorded visits") +
          theme(
            axis.text.y = element_text(size = 14),
            text = element_text(size = 16),
            axis.text.x = element_text(
              size = 14,
              face = "italic",
              angle = 90,
              vjust = 0.5,
              hjust = 1
            )
          ) +
          scale_x_discrete(
            labels = function(x)
              gsub("_", " ", x, fixed = TRUE)
          )
      }
    } else if (input$data2 == "NATAG") {
      DF1 <- data.frame(Plant = colnames(NATAG),
                        Count = as.vector(t(NATAG[which(rownames(NATAG) %in% input$bee_vis),])))
      if (sum(DF1$Count) == 0) {
        plot.new()
      } else{
        DF <- DF1 %>% filter(Count > 0)
        ggplot(DF, aes(x = Plant, y = Count)) + geom_bar(stat = "identity") +
          theme_minimal() +
          xlab("Visited flowering plants") + ylab("Number of recorded visits") +
          theme(
            axis.text.y = element_text(size = 14),
            text = element_text(size = 16),
            axis.text.x = element_text(
              size = 14,
              face = "italic",
              angle = 90,
              vjust = 0.5,
              hjust = 1
            )
          ) +
          scale_x_discrete(
            labels = function(x)
              gsub("_", " ", x, fixed = TRUE)
          )
      }
    } else if (input$data2 == "COMBI") {
      DF1 <- data.frame(Plant = colnames(COMBI),
                        Count = as.vector(t(COMBI[which(rownames(COMBI) %in% input$bee_vis),])))
      if (sum(DF1$Count) == 0) {
        plot.new()
      } else{
        DF <- DF1 %>% filter(Count > 0)
        ggplot(DF, aes(x = Plant, y = Count)) + geom_bar(stat = "identity") +
          theme_minimal() +
          xlab("Visited flowering plants") + ylab("Number of recorded visits") +
          theme(
            axis.text.y = element_text(size = 14),
            text = element_text(size = 16),
            axis.text.x = element_text(
              size = 14,
              face = "italic",
              angle = 90,
              vjust = 0.5,
              hjust = 1
            )
          ) +
          scale_x_discrete(
            labels = function(x)
              gsub("_", " ", x, fixed = TRUE)
          )
      }
    } else if (input$data2 == "USER") {
      if (is.null(inFile))
        return(NULL)
      DF1 <-
        data.frame(Plant = colnames(read.csv(inFile$datapath, row.names = 1)),
                   Count = as.vector(t(
                     read.csv(inFile$datapath, row.names = 1)[which(rownames(read.csv(inFile$datapath, row.names =
                                                                                        1)) %in% input$bee_vis),]
                   )))
      if (sum(DF1$Count) == 0) {
        plot.new()
      } else{
        DF <- DF1 %>% filter(Count > 0)
        ggplot(DF, aes(x = Plant, y = Count)) + geom_bar(stat = "identity") +
          theme_minimal() +
          xlab("Visited flowering plants") + ylab("Number of recorded visits") +
          theme(
            axis.text.y = element_text(size = 14),
            text = element_text(size = 16),
            axis.text.x = element_text(
              size = 14,
              face = "italic",
              angle = 90,
              vjust = 0.5,
              hjust = 1
            )
          ) +
          scale_x_discrete(
            labels = function(x)
              gsub("_", " ", x, fixed = TRUE)
          )
      }
    }
    
  })
  
  output$BARALPP <- renderPlot({
    inFile <- input$file2
    
    if (input$data2 == "ULB") {
      DF3 <- data.frame(WildBees = row.names(ULB),
                        Count = ULB[, which(colnames(ULB) %in% input$plant_vis)])
      if (sum(DF3$Count) == 0) {
