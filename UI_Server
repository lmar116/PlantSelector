            axis.text.x = element_text(
              size = 14,
              face = "italic",
              angle = 90,
              vjust = 0.5,
              hjust = 1
            )
          ) +
          scale_x_discrete(
            labels = function(x)
              gsub("_", " ", x, fixed = TRUE)
          )
      }
    } else if (input$data2 == "NATAG") {
      DF3 <- data.frame(WildBees = row.names(NATAG),
                        Count = NATAG[, which(colnames(NATAG) %in% input$plant_vis)])
      if (sum(DF3$Count) == 0) {
        plot.new()
      } else{
        DF2 <- DF3 %>% filter(Count > 0)
        ggplot(DF2, aes(x = WildBees, y = Count)) + geom_bar(stat = "identity") +
          theme_minimal() +
          xlab("Wild bee visitors") + ylab("Number of recorded visits") +
          theme(
            axis.text.y = element_text(size = 14),
