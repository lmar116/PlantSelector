            )
          ) +
          scale_x_discrete(
            labels = function(x)
              gsub("_", " ", x, fixed = TRUE)
          )
      }
    } else if (input$data2 == "COMBI") {
      DF3 <- data.frame(WildBees = row.names(COMBI),
                        Count = COMBI[, which(colnames(COMBI) %in% input$plant_vis)])
      if (sum(DF3$Count) == 0) {
